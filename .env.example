# Public identifiers only. Configure in Hostinger build settings and rebuild.
VITE_SANITY_PROJECT_ID=v6jdx1wm
VITE_SANITY_DATASET=production
# Subscriptions use /api/newsletter and /api/waitlist (Netlify Functions).
# Server-only configuration below. Never prefix secrets with VITE_ or SANITY_STUDIO_.
# Leave disabled until Reach, privacy notice and consent retention are configured.
REACH_ENABLED=false
REACH_API_TOKEN=
REACH_PROFILE_ID=
CONSENT_HASH_SECRET=
# Optional backend overrides; defaults match the public project.
SANITY_PROJECT_ID=v6jdx1wm
SANITY_DATASET=production
# Optional private forms backend (not Sanity).
# VITE_POCKETBASE_URL=https://your-backend.example.com

# Hostinger Node.js only (server runtime, not VITE_):
PUBLIC_ORIGIN=https://darkblue-alligator-613930.hostingersite.com
# Set an absolute persistent directory outside public_html and deployment folders.
# PRIVATE_DATA_DIR=/home/YOUR_USER/wananga-private

# Optional Brevo trial: only NEW contact/application forms from these emails are copied.
# Reach remains responsible for newsletter/waitlists. Keep off until setup + live tests pass.
BREVO_TRIAL_ENABLED=false
BREVO_API_KEY=
BREVO_TRIAL_EMAILS=
# Optional when more than one pipeline exists, or a specific starting stage is required:
BREVO_TRIAL_PIPELINE_ID=
BREVO_TRIAL_STAGE_ID=
